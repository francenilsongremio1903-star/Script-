local function buildSnapshot()
    local snap = {}
    local char   = LP.Character
    local hum    = char and char:FindFirstChildOfClass("Humanoid")
    local hrp    = char and char:FindFirstChild("HumanoidRootPart")

    snap.player = {
        name   = LP.Name,
        health = hum and math.floor(hum.Health) or 0,
        maxHP  = hum and math.floor(hum.MaxHealth) or 0,
        speed  = hum and math.floor(hum.WalkSpeed) or 0,
        jump   = hum and math.floor(hum.JumpPower) or 0,
        pos    = hrp and string.format("%.0f,%.0f,%.0f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z) or "?",
        alive  = hum and hum.Health > 0 or false,
        team   = tostring(LP.Team and LP.Team.Name or "none"),
    }

    snap.players = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local pc   = p.Character
            local ph   = pc and pc:FindFirstChildOfClass("Humanoid")
            local pr   = pc and pc:FindFirstChild("HumanoidRootPart")
            local dist = 0
            if hrp and pr then
                dist = math.floor((hrp.Position - pr.Position).Magnitude)
            end
            table.insert(snap.players, {
                name  = p.Name,
                hp    = ph and math.floor(ph.Health) or 0,
                dist  = dist,
                alive = ph and ph.Health > 0 or false,
            })
        end
    end

    snap.game = {
        name    = game.Name,
        placeId = tostring(game.PlaceId),
    }

    snap.remotes = {}
    local function scanRemotes(obj, depth)
        if depth > 6 then return end
        if #snap.remotes >= 25 then return end
        local ok, ch = pcall(function() return obj:GetChildren() end)
        if not ok then return end
        for _, c in ipairs(ch) do
            if c.ClassName == "RemoteEvent" or c.ClassName == "RemoteFunction" then
                table.insert(snap.remotes, c.Name .. "(" .. c.ClassName .. ")")
            end
            scanRemotes(c, depth + 1)
        end
    end
    scanRemotes(game, 0)

    snap.values = {}
    local function scanValues(obj, depth)
        if depth > 5 then return end
        if #snap.values >= 15 then return end
        local ok, ch = pcall(function() return obj:GetChildren() end)
        if not ok then return end
        for _, c in ipairs(ch) do
            if c.ClassName:find("Value") then
                local v = ""
                pcall(function() v = tostring(c.Value) end)
                table.insert(snap.values, c.Name .. "=" .. v)
            end
            scanValues(c, depth + 1)
        end
    end
    scanValues(LP, 0)
    if #snap.values < 10 then scanValues(game:GetService("ReplicatedStorage"), 0) end

    snap.nearby = {}
    if hrp then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if #snap.nearby >= 10 then break end
            if obj:IsA("BasePart") and obj ~= hrp then
                local ok2, dist2 = pcall(function()
                    return (obj.Position - hrp.Position).Magnitude
                end)
                if ok2 and dist2 < 30 then
                    table.insert(snap.nearby, obj.Name .. "(dist:" .. math.floor(dist2) .. ")")
                end
            end
        end
    end

    gameSnapshot = snap
    return snap
end

task.spawn(function()
    while SG.Parent do
