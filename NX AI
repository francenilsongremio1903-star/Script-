end)

local function snapshotToText()
    local s = gameSnapshot
    if not s.player then return "scan pendente..." end
    local lines = {}
    table.insert(lines, "=== ESTADO DO JOGO ===")
    table.insert(lines, "Jogo: " .. (s.game and s.game.name or "?") .. " | PlaceId: " .. (s.game and s.game.placeId or "?"))
    table.insert(lines, string.format("Player: %s | HP:%d/%d | Speed:%d | Jump:%d | Pos:%s",
        s.player.name, s.player.health, s.player.maxHP,
        s.player.speed, s.player.jump, s.player.pos))
    table.insert(lines, "Team: " .. (s.player.team or "none"))
    if #(s.players or {}) > 0 then
        local plist = {}
        for _, p in ipairs(s.players) do
            table.insert(plist, p.name .. "(HP:" .. p.hp .. ",dist:" .. p.dist .. ")")
        end
        table.insert(lines, "Players: " .. table.concat(plist, ", "))
    end
    if #(s.remotes or {}) > 0 then
        table.insert(lines, "Remotes: " .. table.concat(s.remotes, ", "))
    end
    if #(s.values or {}) > 0 then
        table.insert(lines, "Values: " .. table.concat(s.values, ", "))
    end
    if #(s.nearby or {}) > 0 then
        table.insert(lines, "Nearby: " .. table.concat(s.nearby, ", "))
    end
    table.insert(lines, "======================")
    return table.concat(lines, "\n")
end

