-- ======= CRIAR MARCADOR NO MUNDO =======
local function createMarker(pos)
    local p = Instance.new("Part")
    p.Name = "RCS_Cam"
    p.Size = Vector3.new(0.35,0.35,0.55)
    p.CFrame = CFrame.new(pos)
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(0,220,255)
    p.CastShadow = false
    p.Parent = workspace

    -- billboard label
    local bb = Instance.new("BillboardGui",p)
    bb.Size = UDim2.new(0,70,0,22)
    bb.StudsOffset = Vector3.new(0,1.2,0)
    bb.AlwaysOnTop = true
    local lbl = Instance.new("TextLabel",bb)
    lbl.Size = UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(0,255,255)
    lbl.Text = "CAM #"..(#placedCams+1)
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold

    return p
end

-- ======= ATUALIZA LABEL =======
local function refreshLabel()
    local active = currentCam and ("#"..currentCam) or (viewPlayer and viewPlayer.Name) or "—"
    LblCams.Text = "Câmeras: "..#placedCams.."  |  Ativa: "..active
end

-- ======= ENTRAR / SAIR DA CÂMERA =======
local function enterCam(idx)
    if not placedCams[idx] then return end
    currentCam  = idx
    viewPlayer  = nil
    Camera.CameraType = Enum.CameraType.Scriptable
    Camera.CFrame = placedCams[idx].CFrame * CFrame.new(0,0.3,0)
    LblStatus.Text = "Status: câmera #"..idx.." ativa"
    LblHint.Text   = "Toque em ⚡ para interagir perto desta cam"
    refreshLabel()
end

local function exitCam()
    Camera.CameraType = Enum.CameraType.Custom
    currentCam = nil
    viewPlayer = nil
    LblStatus.Text = "Status: livre"
    LblHint.Text   = ""
    refreshLabel()
end

-- ======= MODO COLOCAÇÃO =======
local function togglePlace()
    placingMode = not placingMode
    if placingMode then
        BtnPlace.BackgroundColor3 = Color3.fromRGB(160,25,25)
        BtnPlace.Text = "❌  Cancelar colocação"
        LblStatus.Text = "Status: toque no chão para colocar"
        LblHint.Text   = "Clique/toque onde quer a câmera"
    else
        BtnPlace.BackgroundColor3 = Color3.fromRGB(30,120,70)
        BtnPlace.Text = "📍  Colocar Câmera"
        LblStatus.Text = "Status: livre"
        LblHint.Text   = ""
    end
end

-- ======= INTERAGIR PERTO DA CÂMERA =======
local function interact()
    local origin
    if currentCam and placedCams[currentCam] then
        origin = placedCams[currentCam].Position
    elseif viewPlayer then
        local char = viewPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            origin = char.HumanoidRootPart.Position
        end
    end
    if not origin then LblStatus.Text = "Nenhuma câmera ativa!"; return end

    local count = 0
    local seen  = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Position - origin).Magnitude < 18 then
            local model = obj:FindFirstAncestorOfClass("Model") or obj.Parent
            if model and not seen[model] then
                seen[model] = true
                for _, v in ipairs(model:GetDescendants()) do
                    if v:IsA("RemoteEvent") then
                        pcall(function() v:FireServer() end)
                        count = count + 1
                    elseif v:IsA("ProximityPrompt") then
                        pcall(function()
                            fireproximityprompt(v)
                        end)
                        count = count + 1
                    end
                end
            end
        end
    end
    LblStatus.Text = "Interagido: "..count.." objeto(s)"
end

-- ======= VER CÂMERA DE PLAYER =======
local function cyclePlayerCam()
    local others = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then table.insert(others, p) end
    end
    if #others == 0 then LblStatus.Text = "Nenhum player na sala"; return end

    local nextIdx = 1
    if viewPlayer then
        for i, p in ipairs(others) do
            if p == viewPlayer then nextIdx = (i % #others) + 1; break end
        end
    end

    currentCam  = nil
    viewPlayer  = others[nextIdx]
    Camera.CameraType = Enum.CameraType.Scriptable
    LblStatus.Text = "👁 Vendo: "..viewPlayer.Name
    LblHint.Text   = "⚡ Interagir age perto deste player"
    refreshLabel()
end

-- ======= FOLLOW PLAYER CAM =======
RunService.RenderStepped:Connect(function()
    if viewPlayer then
        local char = viewPlayer.Character
        if char then
            local head = char:FindFirstChild("Head")
            if head then
                Camera.CFrame = head.CFrame
            end
        end
    end
end)

-- ======= INPUT: TOQUE/CLIQUE NO MUNDO PARA COLOCAR =======
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not placingMode then return end
    local isTouch = input.UserInputType == Enum.UserInputType.Touch
    local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    if not (isTouch or isMouse) then return end

    local pos = input.Position
    local ray = Camera:ScreenPointToRay(pos.X, pos.Y)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LP.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude

    local result = workspace:Raycast(ray.Origin, ray.Direction * 600, params)
    if result then
        local marker = createMarker(result.Position + Vector3.new(0, 0.5, 0))
        table.insert(placedCams, marker)
        togglePlace()          -- desativa modo colocação
        enterCam(#placedCams)  -- entra na cam recém-colocada
    end
end)

-- ======= BOTÕES =======
BtnPlace.MouseButton1Click:Connect(togglePlace)

BtnNext.MouseButton1Click:Connect(function()
    if #placedCams == 0 then LblStatus.Text = "Sem câmeras!"; return end
    enterCam((currentCam or 0) % #placedCams + 1)
end)

BtnPrev.MouseButton1Click:Connect(function()
    if #placedCams == 0 then LblStatus.Text = "Sem câmeras!"; return end
    enterCam(((currentCam or 1) - 2) % #placedCams + 1)
end)

BtnInteract.MouseButton1Click:Connect(interact)
BtnExit.MouseButton1Click:Connect(exitCam)

BtnRemove.MouseButton1Click:Connect(function()
    if not currentCam or not placedCams[currentCam] then
        LblStatus.Text = "Nenhuma câmera selecionada"; return
    end
    placedCams[currentCam]:Destroy()
    table.remove(placedCams, currentCam)
    exitCam()
    LblStatus.Text = "Câmera removida"
    refreshLabel()
end)

BtnSpyCam.MouseButton1Click:Connect(cyclePlayerCam)

ToggleBtn.MouseButton1Click:Connect(function()
    menuOpen = not menuOpen
    MF.Visible = menuOpen
    ToggleBtn.Text = menuOpen and "✖" or "📷"
end)

