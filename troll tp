-- Teleporta e fixa todos os NPCs perto de cada jogador (local player)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

-- GUI para ativar/desativar
local gui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 120, 0, 40)
btn.Position = UDim2.new(0.02,0,0.02,0)
btn.Text = "Giants OFF"
btn.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
btn.TextColor3 = Color3.new(1,1,1)

local active = false
btn.MouseButton1Click:Connect(function()
	active = not active
	btn.Text = active and "Giants ON" or "Giants OFF"
end)

local function getNPCs()
	local npcs = {}
	for _,m in ipairs(workspace:GetDescendants()) do
		if m:IsA("BasePart") then
			local parent = m.Parent
			if parent and parent:FindFirstChildOfClass("Humanoid") then
				table.insert(npcs,parent)
			end
		end
	end
	return npcs
end

RunService.Heartbeat:Connect(function()
	if not active or not LocalPlayer.Character then return end
	local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local targetPos = hrp.Position + Vector3.new(0,3,0)
	local t = CFrame.new(targetPos)

	for _,npc in ipairs(getNPCs()) do
		local npcHRP = npc:FindFirstChild("HumanoidRootPart")
		if npcHRP then
			npcHRP.CFrame = t -- teleporta instantaneamente
			npcHRP.Parent = LocalPlayer.Character -- fixa em cada jogador
		end
	end
end)