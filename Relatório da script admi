-- FUNÇÃO: Verifica se é admin-related
local function isAdminRelated(name)
    local lower = name:lower()
    for _, keyword in ipairs(ADMIN_KEYWORDS) do
        if lower:find(keyword) then
            return true, keyword
        end
    end
    return false, nil
end

-- FUNÇÃO: Extrair ID se for asset
local function getAssetId(obj)
    local id = nil
    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        id = tostring(obj.Image):match("%d+")
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        id = tostring(obj.Texture):match("%d+")
    elseif obj:IsA("MeshPart") then
        id = tostring(obj.MeshId):match("%d+")
        local texId = tostring(obj.TextureID):match("%d+")
        return id, texId
    end
    return id, nil
end

-- FUNÇÃO: Scan recursivo
local scanned = 0
local maxScan = 8000

local function deepScan(parent, path)
    if scanned >= maxScan then return end
    
    for _, child in pairs(parent:GetChildren()) do
        if scanned >= maxScan then break end
        scanned = scanned + 1
        
        local fullPath = path .. "/" .. child.Name
        local isAdmin, keyword = isAdminRelated(child.Name)
        
        -- REMOTES DE ADMIN
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("BindableEvent") then
            if isAdmin then
                table.insert(Report.adminRemotes, {
                    type = child.ClassName,
                    name = child.Name,
                    path = fullPath,
                    keyword = keyword,
                    parentType = parent.ClassName
                })
            end
            
            -- Verifica se o remote tem características de backdoor (nomes genéricos + pasta de jogador)
            if child.Name:lower():find("func") or child.Name:lower():find("remote") or child.Name == "Event" then
                if fullPath:find("Backpack") or fullPath:find("Character") or fullPath:find("PlayerGui") then
                    table.insert(Report.backdoorIndicators, {
                        type = child.ClassName,
                        name = child.Name,
                        path = fullPath,
                        risk = "HIGH - Generic remote in player tools"
                    })
                end
            end
        end
        
        -- SCRIPTS DE ADMIN / MODERAÇÃO
        if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("ModuleScript") then
            if isAdmin then
                table.insert(Report.adminScripts, {
                    type = child.ClassName,
                    name = child.Name,
                    path = fullPath,
                    keyword = keyword
                })
            end
            
            -- Anti-cheat detection
            if child.Name:lower():find("anti") or child.Name:lower():find("detect") or 
               child.Name:lower():find("check") or child.Name:lower():find("hack") or
               child.Name:lower():find("exploit") then
                table.insert(Report.antiCheat, {
                    name = child.Name,
                    path = fullPath,
                    type = child.ClassName
                })
            end
        end
        
        -- GUIs ADMIN
        if child:IsA("ScreenGui") or child:IsA("Frame") or child:IsA("TextButton") then
            if isAdmin then
                local assetId, texId = getAssetId(child)
                table.insert(Report.adminGuis, {
                    type = child.ClassName,
                    name = child.Name,
                    path = fullPath,
                    keyword = keyword,
                    assetId = assetId
                })
            end
        end
        
        -- OBJETOS SUSPEITOS GERAIS (injetores, backdoors visuais)
        if child.Name:lower():find("infinite") or child.Name:lower():find("yield") or 
           child.Name:lower():find("backdoor") or child.Name:lower():find("dex") or
           child.Name:lower():find("http") or child.Name:lower():find("webhook") then
            table.insert(Report.suspiciousObjects, {
                name = child.Name,
                path = fullPath,
                class = child.ClassName
            })
        end
        
        -- Recursão
        if #child:GetChildren() > 0 then
            deepScan(child, fullPath)
        end
    end
end

